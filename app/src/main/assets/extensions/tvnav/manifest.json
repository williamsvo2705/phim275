{
  "manifest_version": 2,
  "name": "Phim275 TV Navigation",
  "description": "Điều hướng mọi trang web bằng phím mũi tên của remote (chuyển khối kiểu Android TV).",
  "version": "1.5.1",
  "browser_specific_settings": {
    "gecko": { "id": "tvnav@phim275.tv" }
  },
  "permissions": ["nativeMessaging", "geckoViewAddons", "tabs"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
