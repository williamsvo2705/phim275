<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF0E1116</color>
    <color name="toolbar_bg">#E6161B22</color>
    <color name="accent">#FFE50914</color>
    <color name="text">#FFF2F4F8</color>
    <color name="text_dim">#FF9AA4B2</color>

    <style name="Theme.Phim275" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="ToolbarButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/toolbar_button_bg</item>
    </style>
</resources>
