<?xml version="1.0" encoding="utf-8"?>
<!-- Nền nút: đang chọn = nền sáng hơn + viền đỏ 3dp (nhìn rõ từ xa). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_m" />
            <solid android:color="@color/surface_focus" />
            <stroke android:width="3dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_m" />
            <solid android:color="@color/surface_2" />
        </shape>
    </item>
</selector>
