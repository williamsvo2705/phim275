<?xml version="1.0" encoding="utf-8"?>
<!-- Dòng trong bảng menu: đang chọn = nền sáng + vạch đỏ bên trái. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_m" />
                    <solid android:color="@color/surface_focus" />
                </shape>
            </item>
            <item android:width="5dp" android:gravity="start" android:top="10dp" android:bottom="10dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="@color/accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_m" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
