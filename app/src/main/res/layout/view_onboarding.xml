<?xml version="1.0" encoding="utf-8"?>
<!-- Hướng dẫn lần đầu mở app: cách dùng remote. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6080A0E"
    android:clickable="true">

    <LinearLayout
        android:layout_width="680dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/snackbar_bg"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chào mừng đến Phim275"
            android:textColor="@color/text"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="Trình duyệt chặn quảng cáo, điều khiển hoàn toàn bằng remote"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/text_body" />

        <LinearLayout android:id="@+id/onboarding_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/onboarding_start"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginTop="20dp"
            android:background="@drawable/toolbar_button_bg"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="Bắt đầu  ▶"
            android:textColor="@color/text"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
